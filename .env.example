APP_NAME=Elearning
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=elearning
DB_USERNAME=elearning
DB_PASSWORD=
DB_ENGINE=InnoDB

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=local-elearning
REVERB_APP_KEY=local-elearning-key
REVERB_APP_SECRET=change-this-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=127.0.0.1,localhost
REVERB_BROWSER_LOCAL_HOST=127.0.0.1
REVERB_BROWSER_LOCAL_PORT=8080
REVERB_BROWSER_PUBLIC_HOST=
REVERB_BROWSER_PUBLIC_PORT=443
REVERB_BROWSER_PUBLIC_SCHEME=https
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# The Wi-Fi development command fills REVERB_BROWSER_PUBLIC_HOST automatically.
FILESYSTEM_DISK=local
MEDIA_DISK=chat_private
MEDIA_CONVERSIONS_DISK=chat_private
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Voice calls use STUN during development. Configure TURN for reliable production calls.
VOICE_CALL_RING_TIMEOUT=45
VOICE_CALL_STUN_URLS=stun:stun.l.google.com:19302
VOICE_CALL_TURN_URL=
VOICE_CALL_TURN_USERNAME=
VOICE_CALL_TURN_CREDENTIAL=
VOICE_CALL_TURN_SECRET=
VOICE_CALL_TURN_TTL=3600
VOICE_CALL_HEARTBEAT_TIMEOUT=120
REVERB_MAX_REQUEST_SIZE=65536
REVERB_APP_MAX_MESSAGE_SIZE=65536
CHAT_MAX_ATTACHMENT_SIZE_KB=20480
CHAT_MAX_ATTACHMENT_TOTAL_SIZE_KB=51200
CHAT_MAX_ATTACHMENTS_PER_MESSAGE=10
